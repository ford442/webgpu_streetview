{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "noEmit": true
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.d.ts"
  ],
  "exclude": [
    "scripts/quick-flicker-probe.mjs"
  ]
}
