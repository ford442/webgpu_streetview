# Environment for `python deploy.py` (see deploy.py docstring). Export these in your shell or a
# password manager / GitHub Actions secrets — never commit real values, never copy this file to
# a tracked path with values filled in.

# Required: auth token for the Contabo storage-manager bundle upload API
DEPLOY_TOKEN=

# Recommended: Maps JS key baked into build/static/js/main.*.js at deploy time.
# Must be referrer-restricted for every host you serve from (test.1ink.us, go.1ink.us, localhost).
MAPS_API_KEY=

# Optional: Cesium Ion token (client-visible by design — scope it to your deploy origins in the Ion dashboard)
CESIUM_ION_TOKEN=

# Optional overrides
DEPLOY_TARGET=test
# CONTABO_BASE_URL=https://storage.noahcohn.com
# PROJECT_NAME=streetview
# BUILD_DIR=build
# DEPLOY_FOLDER=
