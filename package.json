{
  "name": "webgpu-react-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": ".",
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8",
    "@webgpu/types": "^0.1.64",
    "ajv": "^8.18.0",
    "piexifjs": "^1.0.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "suncalc": "^1.9.0",
    "three": "^0.160.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "prebuild": "node scripts/prebuild-env.mjs",
    "build": "npm run build:wasm && vite build && ./scripts/verify-build.sh",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:wasm:emscripten": "bash scripts/build-wasm.sh",
    "build:wasm:watch": "bash scripts/build-wasm.sh && echo 'Run npm run build:wasm to rebuild after C++ changes.'",
    "gen:wasm-goldens": "node scripts/gen-wasm-goldens.mjs",
    "gen:look-luts": "node scripts/gen-look-luts.mjs",
    "gen:hero-cabin": "node scripts/gen-hero-cabin-gltf.mjs",
    "capture:look-goldens": "node scripts/capture-look-goldens.mjs",
    "test:cpp": "cmake -S cpp -B cpp/build-host -DCMAKE_BUILD_TYPE=RelWithDebInfo && cmake --build cpp/build-host && ctest --test-dir cpp/build-host --output-on-failure",
    "test:cpp:asan": "cmake -S cpp -B cpp/build-asan -DCMAKE_BUILD_TYPE=Debug -DSTREETVIEW_SANITIZERS=ON && cmake --build cpp/build-asan && ctest --test-dir cpp/build-asan --output-on-failure",
    "check:install": "node scripts/check-install.mjs",
    "pretest": "node scripts/check-install.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "node scripts/check-install.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "validate:maps-key": "node -e \"\nconst k=process.env.REACT_APP_MAPS_API_KEY||process.env.VITE_MAPS_API_KEY||''; const bad=!k||/placeholder|your_|replace/i.test(k);\nconsole.log(bad ? '❌ Key missing or placeholder' : '✅ Key looks configured ('+k.length+' chars)');\nprocess.exit(bad?1:0);\n\"",
    "validate:shaders": "node scripts/validate-shaders.mjs",
    "probe:hold-pause": "node scripts/hold-pause-probe.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep-invert @keyed",
    "test:e2e:keyed": "playwright test",
    "analyze": "source-map-explorer 'build/static/js/*.js' --html /tmp/bundle-report.html",
    "preview": "vite preview"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.61.1",
    "@types/google.maps": "^3.58.1",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "playwright": "1.61.1",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.11",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^2.1.8"
  }
}
