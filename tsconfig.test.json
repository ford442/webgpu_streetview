{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**/*",
    "src/setupTests.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.layer-foundation.json"
    },
    {
      "path": "./tsconfig.layer-state.json"
    },
    {
      "path": "./tsconfig.layer-engine.json"
    },
    {
      "path": "./tsconfig.layer-car.json"
    },
    {
      "path": "./tsconfig.layer-ui.json"
    }
  ]
}
