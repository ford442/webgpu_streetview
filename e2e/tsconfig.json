{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Page-side fixtures import app modules by their Vite URL (`/src/...`).
    "paths": { "/src/*": ["../src/*"] },
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  },
  "include": ["./**/*.ts", "../src/vite-env.d.ts"]
}
