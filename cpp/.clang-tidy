---
# Gating on bugprone-*: WarningsAsErrors fails `npm run lint:cpp` and the
# wasm-cpp-host CI job on any finding. modernize-* stays advisory (prints only).
# Runs against cpp/build-host (never build-asan). A deliberately small set:
# this is numeric, extern "C" ABI code, not idiomatic modern C++.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  modernize-use-nullptr,
  modernize-use-using,
  modernize-deprecated-headers,
  modernize-macro-to-enum
WarningsAsErrors: 'bugprone-*'
CheckOptions:
  # `x >> 16`, `h & 0xFFFFFFu`: a non-negative literal operand is not the bug
  # this check is for. Signed *variables* in bitwise ops still fire.
  - key: bugprone-signed-bitwise.IgnorePositiveIntegerLiterals
    value: true
HeaderFilterRegex: 'cpp/(src|include)/.*'
