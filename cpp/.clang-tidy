---
# Advisory: WarningsAsErrors is empty, so findings print but do not fail CI.
# `npm run lint:cpp` / the wasm-cpp-host job run clang-tidy against
# cpp/build-host (never build-asan). A deliberately small bugprone/modernize
# set: this is numeric, extern "C" ABI code, not idiomatic modern C++.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  modernize-use-nullptr,
  modernize-use-using,
  modernize-deprecated-headers,
  modernize-macro-to-enum
WarningsAsErrors: ''
HeaderFilterRegex: 'cpp/(src|include)/.*'
