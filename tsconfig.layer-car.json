{
  "extends": "./tsconfig.layer.json",
  "$comment": "Layer 'car' of scripts/architecture.json: car. May import only itself and the layers it references. exactOptionalPropertyTypes is not on yet for this layer (car/ and the UI layer still have ~65 optional-property sites to fix); turn it on here when they are clean.",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/layers/car.tsbuildinfo"
  },
  "include": [
    "src/car",
    "src/types/**/*.d.ts",
    "src/vite-env.d.ts",
    "src/car/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "build",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**",
    "src/setupTests.ts",
    "src/vitest-env.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.layer-foundation.json"
    },
    {
      "path": "./tsconfig.layer-state.json"
    },
    {
      "path": "./tsconfig.layer-engine.json"
    }
  ]
}
