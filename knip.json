{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "src/**/*.{test,spec}.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/**/*.{mjs,js,ts}"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "types",
    "nsExports",
    "nsTypes",
    "enumMembers",
    "duplicates"
  ],
  "ignoreBinaries": [
    "cmake",
    "ctest",
    "naga"
  ],
  "ignoreDependencies": [
    "@types/google.maps",
    "@types/webxr"
  ]
}
