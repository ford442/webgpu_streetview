// Do not edit: change the .wesl sources and run `npm run gen:shaders`.

// Temporal resolve (#360): this frame's jittered road (intermediate size) and
// last frame's resolve, reprojected along the motion field (motion.wgsl) →
// the next history (output size, rgba16float: rgb colour, a accumulated
// weight). TemporalPass then presents that history through RCAS
// (upscale.wgsl fs_rcas) — the history itself is never sharpened.
//
// CPU side: src/renderer/temporal/temporalMath.ts (uniform layout, jitter)
// and TemporalPass.ts (targets, ping-pong). Its own uniform block (48 B) —
// never weather slots.
//
// Per output pixel:
//   1. Current: the 3×3 intermediate samples around it, each at the position
//      pass 1 really sampled (pixel centre + jitter), weighted by distance.
//      The kernel is an input pixel wide on a reset (a soft spatial upsample)
//      and narrows to under an output pixel as soon as there is history, so
//      the accumulation converges on the native-resolution image.
//   2. History: last frame's resolve at uv − motion (a sharpened Keys cubic:
//      at the sub-pixel shifts of a pan it neither blurs nor rings, so a
//      pixel resampled for many frames keeps its detail), clipped to the 3×3
//      neighbourhood's YCoCg range (min/max ∩ mean ± clipGamma·σ), its weight
//      cut by how far it had to be clipped. Off-screen or `history` 0: none.
//   3. Blend as a running weighted average, the weight capped at maxWeight.
struct TemporalUniforms {
  inputSize: vec2<f32>, // intermediate (road) size, px
  outputSize: vec2<f32>, // swap chain size, px
  jitter: vec2<f32>, // pass 1's sampling offset this frame, intermediate px
  history: f32, // 1 = blend the history, 0 = this frame alone
  maxWeight: f32, // accumulated weight cap
  peak: f32, // colour ceiling (1 SDR, the extended headroom on ?hdr)
  clipGamma: f32, // variance clip: mean ± clipGamma·σ
  pad0: f32,
  pad1: f32,
}

@group(0) @binding(0) var roadTex: texture_2d<f32>;

@group(0) @binding(1) var historyTex: texture_2d<f32>;

@group(0) @binding(2) var motionTex: texture_2d<f32>;

@group(0) @binding(3) var linearSampler: sampler;

@group(0) @binding(4) var<uniform> u: TemporalUniforms;

struct VertexOutput { @builtin(position) position: vec4<f32> }

@vertex fn vs_main(@builtin(vertex_index) vertexIndex: u32) -> VertexOutput {
  var corners = array<vec2<f32>, 3>(vec2<f32>(-1.0, -1.0), vec2<f32>(3.0, -1.0), vec2<f32>(-1.0, 3.0));
  var out: VertexOutput;
  out.position = vec4<f32>(corners[vertexIndex], 0.0, 1.0);
  return out;
}

// Gaussian falloff, exp(−KERNEL_FALLOFF·d²), d in kernel pixels.
const KERNEL_FALLOFF: f32 = 2.29;

// Kernel pixels per output pixel once the history carries the image
// (> 1: narrower than an output pixel — the history supplies the coverage).
const KERNEL_SHARP: f32 = 1.3;

// History weight at which the kernel has fully narrowed.
const SHARPEN_WEIGHT: f32 = 0.5;

// A reset frame (a soft spatial upsample) counts this much of a sample, so
// the sharp jittered samples that follow outweigh it within a frame or two.
const RESET_WEIGHT: f32 = 0.1;

// The history resampler: Keys' cubic with a = −0.55 (Catmull-Rom is −0.5).
// Its response stays within 0.2 % of 1 below output Nyquist / 2 at every
// sub-pixel shift, where Catmull-Rom loses 3–4 % per frame at 5 px detail —
// compounded over a history's lifetime, the difference between converged
// and soft.
const KEYS_A: f32 = -0.55;

fn rgbToYCoCg(c: vec3<f32>) -> vec3<f32> {
  return vec3<f32>(dot(c, vec3<f32>(0.25, 0.5, 0.25)), dot(c, vec3<f32>(0.5, 0.0, -0.5)), dot(c, vec3<f32>(-0.25, 0.5, -0.25)));
}

fn yCoCgToRgb(c: vec3<f32>) -> vec3<f32> {
  return vec3<f32>(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}

// `q` pulled toward the box centre until it is inside; w = how far outside
// it was (1 = on the surface or inside).
fn clipToBox(boxMin: vec3<f32>, boxMax: vec3<f32>, q: vec3<f32>) -> vec4<f32> {
  let centre = 0.5 * (boxMax + boxMin);
  let extents = 0.5 * (boxMax - boxMin) + vec3<f32>(1e-4);
  let v = q - centre;
  let a = abs(v / extents);
  let outside = max(a.x, max(a.y, a.z));
  if (outside > 1.0) {
    return vec4<f32>(centre + v / outside, outside);
  }
  return vec4<f32>(q, 1.0);
}

fn historyAt(uv: vec2<f32>) -> vec3<f32> {
  return textureSampleLevel(historyTex, linearSampler, uv, 0.0).rgb;
}

// Keys' cubic weights: `keysNear` for taps under a pixel away, `keysFar` for 1–2.
fn keysNear(x: vec2<f32>) -> vec2<f32> {
  return ((KEYS_A + 2.0) * x - (KEYS_A + 3.0)) * x * x + 1.0;
}

fn keysFar(x: vec2<f32>) -> vec2<f32> {
  return ((KEYS_A * x - 5.0 * KEYS_A) * x + 8.0 * KEYS_A) * x - 4.0 * KEYS_A;
}

// The cubic from nine bilinear taps (the middle two weights are positive, so
// each pair is one filtered fetch).
fn historyCubic(uv: vec2<f32>) -> vec3<f32> {
  let size = u.outputSize;
  let samplePos = uv * size;
  let texPos1 = floor(samplePos - 0.5) + 0.5;
  let f = samplePos - texPos1;
  let w0 = keysFar(1.0 + f);
  let w1 = keysNear(f);
  let w2 = keysNear(1.0 - f);
  let w3 = keysFar(2.0 - f);
  let w12 = w1 + w2;
  let offset12 = w2 / w12;
  let p0 = (texPos1 - 1.0) / size;
  let p3 = (texPos1 + 2.0) / size;
  let p12 = (texPos1 + offset12) / size;
  var c = vec3<f32>(0.0);
  c += historyAt(vec2<f32>(p0.x, p0.y)) * w0.x * w0.y;
  c += historyAt(vec2<f32>(p12.x, p0.y)) * w12.x * w0.y;
  c += historyAt(vec2<f32>(p3.x, p0.y)) * w3.x * w0.y;
  c += historyAt(vec2<f32>(p0.x, p12.y)) * w0.x * w12.y;
  c += historyAt(vec2<f32>(p12.x, p12.y)) * w12.x * w12.y;
  c += historyAt(vec2<f32>(p3.x, p12.y)) * w3.x * w12.y;
  c += historyAt(vec2<f32>(p0.x, p3.y)) * w0.x * w3.y;
  c += historyAt(vec2<f32>(p12.x, p3.y)) * w12.x * w3.y;
  c += historyAt(vec2<f32>(p3.x, p3.y)) * w3.x * w3.y;
  // The weights sum to 1 per axis; the negative lobes can undershoot 0.
  return max(c, vec3<f32>(0.0));
}

@fragment fn fs_main(input: VertexOutput) -> @location(0) vec4<f32> {
  let uv = input.position.xy / u.outputSize;
  // Where this output pixel's centre is, in intermediate pixels.
  let c = uv * u.inputSize;

  // ── History ──────────────────────────────────────────────────────────
  let motion = textureSampleLevel(motionTex, linearSampler, uv, 0.0).xy;
  let prevUV = uv - motion / u.inputSize;
  let onScreen = all(prevUV >= vec2<f32>(0.0)) && all(prevUV <= vec2<f32>(1.0));
  var prevWeight = 0.0;
  var hist = vec3<f32>(0.0);
  if (u.history > 0.5 && onScreen) {
    prevWeight = min(textureSampleLevel(historyTex, linearSampler, prevUV, 0.0).a, u.maxWeight);
    hist = historyCubic(prevUV);
  }

  // ── Current ──────────────────────────────────────────────────────────
  // Sample i shows the content at i + 0.5 + jitter; the nearest to c is
  // floor(c − jitter). Distances are in kernel pixels: input pixels on a
  // reset, a fraction of an output pixel once there is history.
  let toKernel = u.outputSize / u.inputSize * KERNEL_SHARP;
  let kernelScale = mix(vec2<f32>(1.0), toKernel, clamp(prevWeight / SHARPEN_WEIGHT, 0.0, 1.0));
  let base = vec2<i32>(floor(c - u.jitter));
  let maxPx = vec2<i32>(u.inputSize) - vec2<i32>(1);
  var sum = vec3<f32>(0.0);
  var wsum = 0.0;
  var wmax = 0.0;
  var m1 = vec3<f32>(0.0);
  var m2 = vec3<f32>(0.0);
  var lo = vec3<f32>(1e9);
  var hi = vec3<f32>(-1e9);
  for (var dy = -1; dy <= 1; dy++) {
    for (var dx = -1; dx <= 1; dx++) {
      let p = base + vec2<i32>(dx, dy);
      let s = textureLoad(roadTex, clamp(p, vec2<i32>(0), maxPx), 0).rgb;
      let d = (vec2<f32>(p) + 0.5 + u.jitter - c) * kernelScale;
      let w = exp(-KERNEL_FALLOFF * dot(d, d));
      sum += s * w;
      wsum += w;
      wmax = max(wmax, w);
      let y = rgbToYCoCg(s);
      m1 += y;
      m2 += y * y;
      lo = min(lo, y);
      hi = max(hi, y);
    }
  }
  let current = sum / max(wsum, 1e-6);

  // ── Clip and blend ───────────────────────────────────────────────────
  var color = current;
  var weight = wmax * RESET_WEIGHT;
  if (prevWeight > 0.0) {
    let mean = m1 / 9.0;
    let sigma = sqrt(max(m2 / 9.0 - mean * mean, vec3<f32>(0.0)));
    let boxMin = max(lo, mean - u.clipGamma * sigma);
    let boxMax = min(hi, mean + u.clipGamma * sigma);
    let clipped = clipToBox(boxMin, boxMax, rgbToYCoCg(hist));
    // History that had to be pulled far is mostly not this pixel any more.
    let keptWeight = prevWeight / clipped.w;
    weight = keptWeight + wmax;
    color = mix(yCoCgToRgb(clipped.xyz), current, wmax / weight);
  }
  color = clamp(color, vec3<f32>(0.0), vec3<f32>(u.peak));
  return vec4<f32>(color, min(weight, u.maxWeight));
}
