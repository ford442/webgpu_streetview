  panY: f32, // current normalized pitch  (0–1)
  transitionProgress: f32,
  holdActive: f32, // 1.0 = freeze on previous frame
  capturePanX: f32, // panX at snapshot capture time
  capturePanY: f32, // panY at snapshot capture time
