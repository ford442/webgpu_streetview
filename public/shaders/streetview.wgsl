// How near the held frame is at a (zoomed) canvas UV: 1 = at the camera,
// 0 = skyline or off the depth map (lib/sceneDepth.wesl heldDepthNearness at
// the snapshot UV the look-around samples). The scene-depth group is group 1
// here (src/renderer/depth/sceneDepthBinding.ts); pass 1 reads only the dolly
// fields and the held shift.
fn heldNearness(baseUV: vec2<f32>) -> f32 {
  let lookScaleH = 4.0 / uniforms.zoom;
  let lookScaleV = 2.8 / uniforms.zoom;
