// Wrap heading delta across the 0/1 seam (e.g. 350° → 10° = +20°, not -340°)
fn wrapDelta(a: f32, b: f32) -> f32 {
  var d = a - b;
  if (d > 0.5) {
    d -= 1.0;
  }
  if (d < -0.5) {
    d += 1.0;
  }
  return d;
}

fn samplePrevWithLookAround(baseUV: vec2<f32>) -> vec3<f32> {
