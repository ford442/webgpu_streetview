# Copy to .env.local (gitignored) and fill in. NEVER commit real values.
#
# Only the keys allowlisted in vite.config.ts (PUBLIC_ENV_KEYS) are inlined into
# the client bundle, and every one of them is visible to any visitor.
# For production prefer the runtime path: public/config.js or `MAPS_API_KEY=... python deploy.py`.

# Google Maps JavaScript API key (restrict by HTTP referrer for every host you serve from).
REACT_APP_MAPS_API_KEY=

# Optional storage API base URL (defaults to the hosted service).
REACT_APP_STORAGE_API_URL=

# The Cesium Ion token is NOT a build-time variable. Set window.CESIUM_ION_TOKEN in
# public/config.js (or deploy with CESIUM_ION_TOKEN=... python deploy.py) and scope the
# token to your deploy origins in the Ion dashboard.
